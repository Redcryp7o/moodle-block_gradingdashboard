<div id="block-gradingdashboard-assign-{{cmid}}" class="block-gradingdashboard-assignment-item block-gradingdashboard-tree-node {{#expanded}}block-gradingdashboard-expanded{{/expanded}}" data-assignmentid="{{assignmentid}}">
    <div class="d-flex justify-content-between align-items-center">
        <div class="block-gradingdashboard-assignment-info d-flex align-items-center">
            <span class="block-gradingdashboard-activity-icon-container" aria-hidden="true">
                {{{icon}}}
            </span>
            <span class="block-gradingdashboard-assignment-name">
                <a href="{{assignmenturl}}">{{title}}</a>
            </span>
        </div>
        <div class="block-gradingdashboard-assignment-actions d-flex align-items-center">
            <div class="block-gradingdashboard-badge-container d-flex align-items-center"
                 data-bs-toggle="tooltip"
                 data-bs-html="true"
                 data-bs-placement="top"
                 title="Pending: {{pendingcount}}<br>🟢 {{#str}} severity_fresh, block_gradingdashboard {{/str}}: {{freshcount}}<br>🟠 {{#str}} severity_waiting, block_gradingdashboard {{/str}}: {{waitingcount}}<br>🔴 {{#str}} severity_overdue, block_gradingdashboard {{/str}}: {{overduecount}}"
                 aria-label="Pending: {{pendingcount}}"
                 tabindex="0">
                <span class="block-gradingdashboard-severity-dot block-gradingdashboard-severity-dot--{{severity}}" aria-hidden="true"></span>
                <span class="block-gradingdashboard-badge-count">
                    {{pendingcount}}
                </span>
            </div>
            <button class="block-gradingdashboard-toggle block-gradingdashboard-assignment-toggle"
                    type="button"
                    data-cmid="{{cmid}}"
                    aria-expanded="{{#expanded}}true{{/expanded}}{{^expanded}}false{{/expanded}}"
                    aria-controls="block-gradingdashboard-students-{{cmid}}"
                    aria-label="{{#str}} expandassignment, block_gradingdashboard, {{title}} {{/str}}">
                <span class="block-gradingdashboard-toggle-icon">
                    {{#pix}} t/collapsed, core {{/pix}}
                </span>
            </button>
        </div>
    </div>
    <!-- Student list wrapper -->
    <div id="block-gradingdashboard-students-{{cmid}}" class="block-gradingdashboard-student-list">
        {{#children}}
            {{> block_gradingdashboard/student}}
        {{/children}}
    </div>
</div>
